# --- Client-side (exposed to the browser, must be prefixed VITE_) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# --- Server-side only (used by /api functions, never exposed to browser) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Must be the EXACT SAME value as ENCRYPTION_KEY in the orchestrator's Railway variables
ENCRYPTION_KEY=generated_key_here

# Must be the EXACT SAME value as INTERNAL_API_TOKEN in the orchestrator's Railway variables
INTERNAL_API_TOKEN=generate_a_long_random_string_here

# Your deployed Railway orchestrator's public URL
ORCHESTRATOR_URL=https://your-orchestrator.up.railway.app
